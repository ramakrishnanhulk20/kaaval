# Public market reads need none of these. Every price, book, candle and instrument
# call in src/bitget works with this file empty.
# Bitget API key. Only needed once Kaaval places orders, never for market data.
BITGET_API_KEY=
# The secret half of that key. Same rule: reads do not use it.
BITGET_SECRET_KEY=
# The passphrase set when the key was created. Reads do not use it.
BITGET_PASSPHRASE=

# Anthropic key for the Claude brain. Without it the Claude brain cannot run at all.
ANTHROPIC_API_KEY=
# Which Claude model the brain calls. Defaults to claude-haiku-4-5-20251001 when this is empty.
KAAVAL_CLAUDE_MODEL=
# Key for Bitget's hackathon Qwen proxy. Without it the Qwen brain is skipped, not failed.
QWEN_API_KEY=
# Base URL for that proxy. Defaults to https://hackathon.bitgetops.com/v1 when empty.
QWEN_BASE_URL=
# Which Qwen model to call. Defaults to qwen3.8-max, the model the program recommends.
QWEN_MODEL=
# Set to 1 to let Qwen think before it answers. Off by default: with it on one call takes about
# a minute through the proxy and the brain misses the tick.
QWEN_THINKING=
# Finnhub key for company news and the earnings calendar. Optional: EDGAR and GDELT need no key.
FINNHUB_API_KEY=
# AskNews key for a news search across many outlets. Optional: without it the source is skipped.
# One search an hour for the whole universe, one credit each, ten articles on the Pro plan.
ASKNEWS_API_KEY=
# Set to 1 to let a review search the AskNews archive for trades older than 48 hours. Off by
# default, because a review asks about every hour ever traded and each ask is a credit.
ASKNEWS_HISTORICAL=
# The contact string SEC demands on every EDGAR request, in the form "Kaaval research you@example.com".
KAAVAL_USER_AGENT=

# Bitget demo trading key. Only the three demo contracts (SBTCSUSDT, SETHSUSDT, SXRPSUSDT) exist there.
BITGET_DEMO_API_KEY=
# The secret half of the demo key. Without all three demo values the crypto legs stay simulated.
BITGET_DEMO_SECRET_KEY=
# The passphrase set when the demo key was created.
BITGET_DEMO_PASSPHRASE=

# Where the signed ledger is written. Defaults to data/state/ledger.
KAAVAL_LEDGER_DIR=
# The engine's memory across restarts. Defaults to data/state/engine.json.
KAAVAL_STATE_FILE=
# Create this file to halt new risk within one tick. Defaults to data/state/KILL.
KAAVAL_KILL_FILE=
# The Ed25519 key the ledger is signed with. Made on first run. Defaults to data/secrets/ledger-key.pem.
KAAVAL_LEDGER_KEY=
# Where news and calendar answers are cached between ticks. Defaults to data/state/news-cache.
KAAVAL_NEWS_CACHE=
# Where the daily universe is cached. Defaults to data/state/universe.json.
KAAVAL_UNIVERSE_FILE=
# Starting balance of each paper account, in USDT. Defaults to 10000.
KAAVAL_PAPER_BALANCE=
# How many hours of news a tick reads back. Defaults to 6.
KAAVAL_NEWS_LOOKBACK_HOURS=
# How many rTokens the universe keeps. Defaults to 6, which is about 45 Bitget reads a tick.
KAAVAL_MAX_SYMBOLS=
# Model runs per brain per tick. Empty means 3 on a normal tick and 2 in event and open windows.
KAAVAL_ENSEMBLE_RUNS=
# How long a brain may think before the tick gives up on it, in milliseconds. Defaults to 180000.
KAAVAL_DECISION_TIMEOUT_MS=
# Brains the operator has stood down, a comma list such as claude. A retired brain has its
# positions closed by reduce-only orders, is never asked again, needs no key, and is still
# marked every tick so its record stays on the board as it closed.
KAAVAL_RETIRED_BRAINS=
# Set to 1 to halt new risk without touching the kill file. Anything else is ignored.
KAAVAL_HALT=

# How long one news, SEC or GDELT request may take, headers and body together, in
# milliseconds. Defaults to 20000.
KAAVAL_HTTP_TIMEOUT_MS=
# How long one Bitget request may take, in milliseconds. The SDK retries a read twice on
# top of this. Defaults to 15000.
KAAVAL_BITGET_TIMEOUT_MS=
# How long a whole tick may take before the engine saves, exits and lets pm2 restart it,
# in milliseconds. Defaults to 600000, and 240000 in the event and open windows.
KAAVAL_TICK_TIMEOUT_MS=

# Where the published record repository lives. Defaults to ../record beside this repo.
KAAVAL_RECORD_DIR=
# The name on the record repository's commits. Defaults to Ram.
KAAVAL_GIT_NAME=
# The email on those commits. Set it before the first push: with neither this nor an owner
# email in STATE.md the publisher says so and git refuses to commit.
KAAVAL_GIT_EMAIL=
# Minutes between publishes when the publisher runs unattended. Defaults to 15.
KAAVAL_PUBLISH_MINUTES=
# The base URL of the published record, read by the site. Set it on a host that has no
# engine beside it, for example https://raw.githubusercontent.com/<user>/<repo>/main.
# Empty means the site reads the files the engine is writing on this machine.
KAAVAL_RECORD_URL=

# The site reads the record from this folder when KAAVAL_RECORD_URL is not set. Defaults to ../data/state from web.
KAAVAL_DATA_DIR=
# Where the proof panel reads the stored proof run. Defaults to data/state/proof/latest.json.
KAAVAL_PROOF_FILE=
# Set to local on the machine that holds the engine so the proof button re-runs the checks; leave unset on Vercel.
KAAVAL_PROOF_RUNNER=

# Kaaval for a trader's own account. These four are only for the tenant path: the engine
# and every market read work with all of them empty.
# The server key that seals a trader's Bitget API key at rest, 64 hex characters, which
# is 32 bytes. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KAAVAL_KEY_SEAL_HEX=
# A trader's own Bitget API key, read-only. Set all three and scripts/plan-for-account.ts
# plans against that real account; leave them empty and it runs the same code against a
# fake account so the command always works.
# The plan script reads these first and falls back to BITGET_API_KEY, BITGET_SECRET_KEY and
# BITGET_PASSPHRASE above, so one read-only key pasted once serves both the engine and the plan.
BITGET_TENANT_API_KEY=
# The secret half of that key.
BITGET_TENANT_SECRET_KEY=
# The passphrase set when that key was created.
BITGET_TENANT_PASSPHRASE=

# The account area on the site: sign-in, the database, and the signed plans. The engine,
# the record and every market read work with all five of these empty; the screens then say
# plainly that sign-in is not configured on this host.
# The Privy app id. Public by design, it is inlined into the browser bundle.
NEXT_PUBLIC_PRIVY_APP_ID=
# The Privy app secret. Server only. It is what proves a trader's sign-in token is real.
PRIVY_APP_SECRET=
# The Postgres connection string for the trader database, the pooled one from the Neon
# console, for example postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require
DATABASE_URL=
# Optional, and only for migrations: the same database without the pooler in front of it,
# the string Neon labels direct. Table and index changes go down this one, because the
# pooler can hand a statement a different session than the one that started the work. Left
# empty, scripts/migrate.mts uses DATABASE_URL.
# DATABASE_URL_DIRECT=
# The Ed25519 private key every stored plan is signed with, the whole PEM including the
# BEGIN and END lines. Without it a plan is still made and stored, and says it is unsigned.
KAAVAL_PLAN_KEY_PEM=
# Model runs per brain when a plan is made from the site. Defaults to 1, because a trader
# is waiting for it. Between 1 and 5.
KAAVAL_WEB_ENSEMBLE_RUNS=

# Where the sister site lives, for the one link in the footer. Defaults to https://vidiyal-agent.vercel.app;
# set http://localhost:3001 when both dev servers run on one machine.
VIDIYAL_URL=
